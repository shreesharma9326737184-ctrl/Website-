<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Chunky Sips – Pune's Wildest Smoothies</title>
  <link href="https://fonts.googleapis.com/css2?family=Boogaloo&family=Nunito:wght@400;600;800&family=Pacifico&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --yellow: #FFD84D;
      --orange: #FF6B35;
      --green: #4ECB71;
      --pink: #FF5FA0;
      --purple: #7B4FD9;
      --dark: #1A0A2E;
      --light: #FFF8EC;
      --glass: rgba(255,255,255,0.12);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Nunito', sans-serif;
      background: var(--dark);
      color: var(--light);
      overflow-x: hidden;
    }

    /* ──────────── NOISE OVERLAY ──────────── */
    body::before {
      content: '';
      position: fixed; inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
      pointer-events: none; z-index: 0;
    }

    /* ──────────── NAVBAR ──────────── */
    nav {
      position: fixed; top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 18px 48px;
      background: rgba(26,10,46,0.82);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(255,255,255,0.07);
    }

    .logo {
      font-family: 'Pacifico', cursive;
      font-size: 1.9rem;
      background: linear-gradient(135deg, var(--yellow), var(--orange));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-shadow: none;
    }

    .nav-links { display: flex; gap: 32px; list-style: none; }
    .nav-links a {
      color: rgba(255,248,236,0.75);
      text-decoration: none;
      font-weight: 700;
      font-size: 0.95rem;
      letter-spacing: 0.5px;
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--yellow); }

    .nav-cta {
      background: linear-gradient(135deg, var(--orange), var(--pink));
      color: #fff !important;
      padding: 10px 22px;
      border-radius: 50px;
      font-weight: 800 !important;
      transition: transform 0.2s, box-shadow 0.2s !important;
      box-shadow: 0 4px 20px rgba(255,107,53,0.45);
    }
    .nav-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(255,107,53,0.6); color: #fff !important; }

    /* ──────────── HERO ──────────── */
    .hero {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      padding: 120px 80px 80px;
      position: relative;
      overflow: hidden;
    }

    /* animated gradient blobs */
    .blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(90px);
      opacity: 0.35;
      animation: drift 8s ease-in-out infinite alternate;
    }
    .blob-1 { width: 500px; height: 500px; background: var(--purple); top: -100px; right: 100px; animation-delay: 0s; }
    .blob-2 { width: 380px; height: 380px; background: var(--orange); bottom: 0; left: -60px; animation-delay: -3s; }
    .blob-3 { width: 280px; height: 280px; background: var(--green); top: 40%; right: 5%; animation-delay: -6s; }

    @keyframes drift {
      from { transform: translate(0, 0) scale(1); }
      to   { transform: translate(30px, 40px) scale(1.08); }
    }

    .hero-text { position: relative; z-index: 2; }
    .hero-eyebrow {
      display: inline-block;
      background: var(--glass);
      border: 1px solid rgba(255,255,255,0.18);
      padding: 6px 16px;
      border-radius: 50px;
      font-size: 0.82rem;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--yellow);
      margin-bottom: 20px;
    }

    .hero-title {
      font-family: 'Boogaloo', cursive;
      font-size: clamp(3.2rem, 6vw, 5.5rem);
      line-height: 1.05;
      margin-bottom: 20px;
    }
    .hero-title span { color: var(--yellow); }

    .hero-sub {
      font-size: 1.15rem;
      color: rgba(255,248,236,0.7);
      max-width: 480px;
      line-height: 1.7;
      margin-bottom: 36px;
    }

    .hero-btns { display: flex; gap: 16px; flex-wrap: wrap; }

    .btn-primary {
      background: linear-gradient(135deg, var(--yellow), var(--orange));
      color: var(--dark);
      font-weight: 800;
      font-size: 1rem;
      padding: 16px 36px;
      border-radius: 50px;
      border: none;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      box-shadow: 0 6px 30px rgba(255,216,77,0.45);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .btn-primary:hover { transform: translateY(-3px) scale(1.03); box-shadow: 0 12px 40px rgba(255,107,53,0.5); }

    .btn-outline {
      background: transparent;
      color: var(--light);
      font-weight: 700;
      font-size: 1rem;
      padding: 15px 34px;
      border-radius: 50px;
      border: 2px solid rgba(255,255,255,0.25);
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      transition: border-color 0.2s, background 0.2s;
    }
    .btn-outline:hover { border-color: var(--yellow); background: rgba(255,216,77,0.08); }

    /* ──────────── 3-D CUP SCENE ──────────── */
    .hero-visual {
      display: flex; align-items: center; justify-content: center;
      position: relative; z-index: 2;
      perspective: 900px;
    }

    .cup-scene {
      width: 280px; height: 420px;
      transform-style: preserve-3d;
      animation: spin3d 12s ease-in-out infinite;
    }

    @keyframes spin3d {
      0%   { transform: rotateY(-18deg) rotateX(6deg); }
      50%  { transform: rotateY(18deg)  rotateX(-4deg); }
      100% { transform: rotateY(-18deg) rotateX(6deg); }
    }

    .cup-wrap {
      position: relative; width: 100%; height: 100%;
      transform-style: preserve-3d;
    }

    /* SVG cup */
    .cup-svg {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      filter: drop-shadow(0 30px 60px rgba(0,0,0,0.7));
    }

    /* floating fruit orbs */
    .fruit {
      position: absolute;
      border-radius: 50%;
      animation: floatFruit 4s ease-in-out infinite alternate;
      font-size: 2.2rem;
      transform-style: preserve-3d;
    }
    .fruit-1 { top: -30px; left: -50px; animation-delay: 0s; }
    .fruit-2 { top: 60px; right: -60px; animation-delay: -1s; font-size: 2.8rem; }
    .fruit-3 { bottom: 80px; left: -60px; animation-delay: -2s; font-size: 2rem; }
    .fruit-4 { bottom: 20px; right: -40px; animation-delay: -3s; font-size: 2.6rem; }

    @keyframes floatFruit {
      from { transform: translateY(0) translateZ(0) rotate(-5deg); }
      to   { transform: translateY(-18px) translateZ(30px) rotate(10deg); }
    }

    /* ──────────── STATS BAR ──────────── */
    .stats {
      display: flex; gap: 0;
      border-top: 1px solid rgba(255,255,255,0.07);
      border-bottom: 1px solid rgba(255,255,255,0.07);
      position: relative; z-index: 2;
    }

    .stat {
      flex: 1; padding: 28px 0;
      text-align: center;
      border-right: 1px solid rgba(255,255,255,0.07);
    }
    .stat:last-child { border-right: none; }

    .stat-num {
      font-family: 'Boogaloo', cursive;
      font-size: 2.4rem;
      color: var(--yellow);
      line-height: 1;
    }
    .stat-label {
      font-size: 0.8rem;
      color: rgba(255,248,236,0.5);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-top: 4px;
    }

    /* ──────────── SECTION TITLE ──────────── */
    .section-tag {
      display: inline-block;
      font-size: 0.75rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--green);
      margin-bottom: 12px;
    }
    .section-title {
      font-family: 'Boogaloo', cursive;
      font-size: clamp(2rem, 4vw, 3.2rem);
      line-height: 1.1;
    }

    /* ──────────── MENU SECTION ──────────── */
    #menu {
      padding: 100px 80px;
      position: relative;
    }

    .menu-header { text-align: center; margin-bottom: 60px; }

    .menu-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 28px;
    }

    /* 3-D card */
    .menu-card {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 28px;
      padding: 36px 28px;
      text-align: center;
      transition: transform 0.35s cubic-bezier(0.23,1,0.32,1), box-shadow 0.35s;
      transform-style: preserve-3d;
      cursor: pointer;
      position: relative;
      overflow: hidden;
    }

    .menu-card::before {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,0.08) 0%, transparent 60%);
      border-radius: inherit;
    }

    .menu-card:hover {
      transform: translateY(-12px) rotateX(4deg) rotateY(-3deg) scale(1.02);
      box-shadow: 0 30px 60px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.15);
    }

    .card-emoji { font-size: 3.6rem; margin-bottom: 14px; display: block; }
    .card-name {
      font-family: 'Boogaloo', cursive;
      font-size: 1.5rem;
      color: var(--light);
      margin-bottom: 8px;
    }
    .card-desc {
      font-size: 0.88rem;
      color: rgba(255,248,236,0.58);
      line-height: 1.6;
      margin-bottom: 18px;
    }
    .card-price {
      font-weight: 800;
      font-size: 1.1rem;
      color: var(--yellow);
    }
    .card-tag {
      display: inline-block;
      margin-top: 12px;
      font-size: 0.72rem;
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: 4px 14px;
      border-radius: 50px;
      font-weight: 700;
    }
    .tag-best { background: rgba(255,216,77,0.18); color: var(--yellow); }
    .tag-new  { background: rgba(78,203,113,0.18); color: var(--green); }
    .tag-hot  { background: rgba(255,107,53,0.18); color: var(--orange); }
    .tag-vibe { background: rgba(123,79,217,0.18); color: #B48AFF; }

    /* accent stripe on card top */
    .menu-card[data-accent="yellow"]  { border-top: 3px solid var(--yellow); }
    .menu-card[data-accent="green"]   { border-top: 3px solid var(--green); }
    .menu-card[data-accent="orange"]  { border-top: 3px solid var(--orange); }
    .menu-card[data-accent="pink"]    { border-top: 3px solid var(--pink); }
    .menu-card[data-accent="purple"]  { border-top: 3px solid var(--purple); }
    .menu-card[data-accent="teal"]    { border-top: 3px solid #38D9D9; }

    /* ──────────── WHY US ──────────── */
    #why {
      padding: 100px 80px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
    }

    .why-visual {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .why-tile {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 22px;
      padding: 28px 22px;
      transition: transform 0.3s;
    }
    .why-tile:hover { transform: scale(1.03); }
    .why-tile.tall { grid-row: span 2; }

    .tile-icon { font-size: 2.2rem; margin-bottom: 12px; }
    .tile-title {
      font-family: 'Boogaloo', cursive;
      font-size: 1.2rem;
      margin-bottom: 6px;
    }
    .tile-text { font-size: 0.85rem; color: rgba(255,248,236,0.55); line-height: 1.5; }

    .why-points { display: flex; flex-direction: column; gap: 24px; }
    .why-point {
      display: flex; gap: 16px; align-items: flex-start;
    }
    .why-dot {
      width: 40px; height: 40px;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem;
      flex-shrink: 0;
    }
    .dot-yellow { background: rgba(255,216,77,0.2); }
    .dot-green  { background: rgba(78,203,113,0.2); }
    .dot-pink   { background: rgba(255,95,160,0.2); }
    .dot-orange { background: rgba(255,107,53,0.2); }

    .why-point-text h4 {
      font-weight: 800; font-size: 1rem; margin-bottom: 4px;
    }
    .why-point-text p {
      font-size: 0.85rem; color: rgba(255,248,236,0.55); line-height: 1.5;
    }

    /* ──────────── LOCATION ──────────── */
    #location {
      padding: 100px 80px;
      text-align: center;
    }

    .location-box {
      max-width: 780px; margin: 0 auto;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 32px;
      padding: 60px 48px;
      position: relative;
      overflow: hidden;
    }

    .location-box::before {
      content: '';
      position: absolute; top: -80px; right: -80px;
      width: 280px; height: 280px;
      background: radial-gradient(circle, rgba(255,107,53,0.25), transparent 70%);
    }

    .map-pin { font-size: 3.5rem; margin-bottom: 16px; display: block; }
    .location-title {
      font-family: 'Boogaloo', cursive;
      font-size: 2.2rem; margin-bottom: 10px;
    }
    .location-address {
      font-size: 1.05rem;
      color: var(--yellow);
      font-weight: 700;
      margin-bottom: 20px;
    }
    .location-hours {
      display: flex; gap: 32px; justify-content: center;
      flex-wrap: wrap; margin-top: 28px;
    }
    .hours-block {
      background: rgba(255,255,255,0.06);
      border-radius: 16px;
      padding: 16px 24px;
      min-width: 160px;
    }
    .hours-label { font-size: 0.75rem; color: rgba(255,248,236,0.45); letter-spacing: 1px; text-transform: uppercase; }
    .hours-time  { font-weight: 800; font-size: 1rem; margin-top: 4px; color: var(--light); }

    /* ──────────── FOOTER ──────────── */
    footer {
      padding: 48px 80px;
      border-top: 1px solid rgba(255,255,255,0.07);
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 20px;
    }
    .footer-logo {
      font-family: 'Pacifico', cursive;
      font-size: 1.4rem;
      background: linear-gradient(135deg, var(--yellow), var(--orange));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .footer-text { font-size: 0.82rem; color: rgba(255,248,236,0.35); }
    .socials { display: flex; gap: 14px; }
    .social-btn {
      width: 40px; height: 40px; border-radius: 50%;
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.1);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem; cursor: pointer; text-decoration: none;
      transition: background 0.2s, transform 0.2s;
    }
    .social-btn:hover { background: rgba(255,216,77,0.18); transform: translateY(-2px); }

    /* ──────────── SCROLL REVEAL ──────────── */
    .reveal {
      opacity: 0;
      transform: translateY(36px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }
    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* ──────────── RESPONSIVE ──────────── */
    @media (max-width: 900px) {
      .hero { grid-template-columns: 1fr; padding: 110px 28px 60px; text-align: center; }
      .hero-visual { display: none; }
      .hero-btns { justify-content: center; }
      #menu { padding: 80px 28px; }
      #why { grid-template-columns: 1fr; padding: 80px 28px; }
      #location { padding: 80px 28px; }
      nav { padding: 14px 24px; }
      .nav-links { display: none; }
      footer { padding: 36px 28px; flex-direction: column; text-align: center; }
    }
  </style>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="logo">Chunky Sips</div>
  <ul class="nav-links">
    <li><a href="#menu">Menu</a></li>
    <li><a href="#why">Why Us</a></li>
    <li><a href="#location">Find Us</a></li>
    <li><a href="#location" class="nav-cta">Order Now</a></li>
  </ul>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>
  <div class="blob blob-3"></div>

  <div class="hero-text">
    <div class="hero-eyebrow">🏙 FC Road, Pune</div>
    <h1 class="hero-title">
      Sip Bold.<br>
      <span>Chunk It Up.</span>
    </h1>
    <p class="hero-sub">
      Pune's most outrageous smoothie bar – bursting with real fruit chunks, legendary blends, and zero apologies. Made fresh every sip.
    </p>
    <div class="hero-btns">
      <a href="#menu" class="btn-primary">Explore Menu 🍓</a>
      <a href="#location" class="btn-outline">Visit Us 📍</a>
    </div>
  </div>

  <div class="hero-visual">
    <div class="cup-scene">
      <div class="cup-wrap">
        <!-- 3D Cup SVG -->
        <svg class="cup-svg" viewBox="0 0 280 420" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="cupGrad" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#FF6B35"/>
              <stop offset="50%" stop-color="#FF5FA0"/>
              <stop offset="100%" stop-color="#7B4FD9"/>
            </linearGradient>
            <linearGradient id="lidGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#fff" stop-opacity="0.6"/>
              <stop offset="100%" stop-color="#fff" stop-opacity="0.15"/>
            </linearGradient>
            <linearGradient id="liquidGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#FFD84D" stop-opacity="0.95"/>
              <stop offset="100%" stop-color="#FF6B35" stop-opacity="0.9"/>
            </linearGradient>
            <linearGradient id="shimmer" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#fff" stop-opacity="0"/>
              <stop offset="40%" stop-color="#fff" stop-opacity="0.18"/>
              <stop offset="100%" stop-color="#fff" stop-opacity="0"/>
            </linearGradient>
            <clipPath id="cupClip">
              <path d="M50 100 Q45 380 80 400 L200 400 Q235 380 230 100 Z"/>
            </clipPath>
          </defs>

          <!-- shadow -->
          <ellipse cx="140" cy="410" rx="90" ry="10" fill="#000" opacity="0.4"/>

          <!-- cup body -->
          <path d="M50 100 Q45 380 80 400 L200 400 Q235 380 230 100 Z" fill="url(#cupGrad)"/>

          <!-- liquid fill -->
          <g clip-path="url(#cupClip)">
            <rect x="0" y="150" width="280" height="260" fill="url(#liquidGrad)" opacity="0.92"/>
            <!-- wave top -->
            <path d="M30 150 Q80 135 140 150 Q200 165 250 150 L250 175 Q200 190 140 175 Q80 160 30 175 Z" fill="#FFD84D" opacity="0.6"/>
          </g>

          <!-- fruit chunks inside cup -->
          <g clip-path="url(#cupClip)">
            <circle cx="100" cy="220" r="14" fill="#4ECB71" opacity="0.85"/>
            <circle cx="160" cy="250" r="12" fill="#FF5FA0" opacity="0.85"/>
            <circle cx="120" cy="290" r="10" fill="#FFD84D" opacity="0.9"/>
            <circle cx="175" cy="310" r="15" fill="#FF6B35" opacity="0.75"/>
            <circle cx="90"  cy="330" r="11" fill="#7B4FD9" opacity="0.7"/>
          </g>

          <!-- shimmer -->
          <path d="M50 100 Q45 380 80 400 L200 400 Q235 380 230 100 Z" fill="url(#shimmer)"/>

          <!-- cup top rim -->
          <ellipse cx="140" cy="100" rx="92" ry="18" fill="#fff" opacity="0.15"/>
          <ellipse cx="140" cy="100" rx="90" ry="16" stroke="#fff" stroke-width="2" fill="none" opacity="0.35"/>

          <!-- lid -->
          <path d="M44 96 Q140 72 236 96 L230 108 Q140 86 50 108 Z" fill="url(#lidGrad)"/>
          <rect x="125" y="55" width="30" height="44" rx="6" fill="url(#lidGrad)" opacity="0.9"/>
          <ellipse cx="140" cy="55" rx="18" ry="6" fill="#fff" opacity="0.4"/>

          <!-- straw -->
          <rect x="155" y="20" width="12" height="120" rx="6" fill="#4ECB71"/>
          <rect x="156" y="22" width="5" height="116" rx="3" fill="#fff" opacity="0.25"/>

          <!-- brand text on cup -->
          <text x="140" y="370" text-anchor="middle" font-family="'Pacifico', cursive" font-size="20" fill="#fff" opacity="0.8">Chunky Sips</text>

          <!-- highlight -->
          <path d="M65 130 Q72 270 90 370" stroke="#fff" stroke-width="6" stroke-linecap="round" opacity="0.12"/>
        </svg>

        <!-- floating fruit emoji -->
        <div class="fruit fruit-1">🍓</div>
        <div class="fruit fruit-2">🥭</div>
        <div class="fruit fruit-3">🍌</div>
        <div class="fruit fruit-4">🍇</div>
      </div>
    </div>
  </div>
</section>

<!-- STATS -->
<div class="stats">
  <div class="stat reveal">
    <div class="stat-num">40+</div>
    <div class="stat-label">Smoothie Flavors</div>
  </div>
  <div class="stat reveal" style="transition-delay:0.1s">
    <div class="stat-num">100%</div>
    <div class="stat-label">Fresh Fruit</div>
  </div>
  <div class="stat reveal" style="transition-delay:0.2s">
    <div class="stat-num">5K+</div>
    <div class="stat-label">Happy Sippers</div>
  </div>
  <div class="stat reveal" style="transition-delay:0.3s">
    <div class="stat-num">0</div>
    <div class="stat-label">Artificial Stuff</div>
  </div>
</div>

<!-- MENU -->
